PORT=3000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed browser origins (e.g. https://your-frontend.example.com)
CLIENT_URL=
# --- Optional AI enhancement (app works without any of this) ---
AI_API_KEY=
AI_MODEL=
# anthropic (default) or openai (any OpenAI-compatible endpoint)
AI_PROVIDER=anthropic
# Optional override, e.g. https://api.openai.com/v1
AI_BASE_URL=
# Optional: enables embedding-based semantic matching (openai-compatible providers)
AI_EMBEDDING_MODEL=

# --- Resume upload & extraction ---
# Maximum resume size in MB (1-20)
MAX_RESUME_MB=5
# Uploads allowed per user per 15 minutes
UPLOAD_RATE_LIMIT=40
# Use the AI model (when AI_API_KEY/AI_MODEL are set) to structure resumes. false = rule-based extraction only
AI_RESUME_EXTRACTION=true
# Provider timeout in ms and maximum resume characters sent to the model
AI_TIMEOUT_MS=20000
AI_MAX_RESUME_CHARS=24000
# Delete the stored extracted resume text after N days (0 = keep until the candidate is deleted). Files are never stored.
RESUME_TEXT_RETENTION_DAYS=0
